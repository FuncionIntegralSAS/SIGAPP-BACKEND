# ============================================================
#  Plantilla de variables de entorno - SIGAPP Backend
#  Copiar a .env y rellenar. El archivo .env NO se versiona.
#      cp .env.example .env
# ============================================================

# --- Oracle (OBLIGATORIAS: la app no arranca sin ellas) ---
DB_TNS=jdbc:oracle:thin:@//HOST:PUERTO/SERVICIO
DB_USERNAME=
DB_PASSWORD=

# --- JWT (OBLIGATORIA) ---
# Minimo 256 bits. Generar una nueva por ambiente, nunca reutilizar la de dev:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=28800000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# --- Aplicacion ---
SERVER_PORT=8082
# true DESACTIVA toda la seguridad. Jamas true fuera de local.
SECURITY_DEVELOPER_MODE=false
APP_FEATURES_ENVIO_CORREO=false
