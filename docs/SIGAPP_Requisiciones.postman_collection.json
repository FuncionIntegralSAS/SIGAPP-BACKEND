        "description": "Las lineas que no vengan en el cuerpo NO se tocan.\n\nAprobar no mueve inventario y no exige ser responsable de la bodega.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lineas\": [\n    {\n      \"articulo\": \"{{articulo}}\",\n      \"bodega\": \"{{bodega}}\",\n      \"secuencia\": 1,\n      \"cantidad\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
