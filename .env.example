# ============================================================
#  Plantilla de variables de entorno - SIGAPP Backend
#  Copiar a .env y rellenar. El archivo .env NO se versiona.
#      cp .env.example .env
# ============================================================

# --- Oracle (OBLIGATORIAS: la app no arranca sin ellas) ---
# El usuario es el de INTERFAZ del ERP (ARQGUI<empresa>), no el dueno SRF: las
# consultas nombran las tablas como las ve ese usuario (SRF_BODEGA, FI_COFIUSCO).
# Conectado como SRF los nombres SRF_ no existen y nada funciona.
DB_TNS=jdbc:oracle:thin:@//HOST:PUERTO/SERVICIO
DB_USERNAME=ARQGUIPNACUA
DB_PASSWORD=

# --- JWT (OBLIGATORIA) ---
# Minimo 256 bits. Generar una nueva por ambiente, nunca reutilizar la de dev:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=28800000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# --- Aplicacion ---
SERVER_PORT=8082
# true DESACTIVA toda la seguridad. Jamas true fuera de local.
SECURITY_DEVELOPER_MODE=false
APP_FEATURES_ENVIO_CORREO=false

# --- Opcionales: tienen valor por defecto en application.properties ---
# Solo hace falta declararlas para cambiar el default.

# Tope de la firma manuscrita, en BYTES ya decodificados. Rige para traspasos y
# para requisiciones: FirmaUtil es un bean compartido.
# APP_TRASPASOS_FIRMA_MAX_BYTES=512000
# APP_TRASPASOS_MAX_ARTICULOS=50

# Requisiciones. La ventana y el tope de la bandeja no son cosmeticos: MOVIRESU
# tiene mas de cien mil lineas registradas y sin cota la consulta por estado
# 'rg' traeria media tabla.
# APP_REQUISICIONES_MAX_LINEAS=200
# APP_REQUISICIONES_DIAS_BANDEJA=90
# APP_REQUISICIONES_MAX_BANDEJA=500
