    },
    {
      "name": "6. Entregar las 100",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/requisiciones/{{empresa}}/{{tipoDocumento}}/{{numero}}/entregar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "requisiciones",
            "{{empresa}}",
            "{{tipoDocumento}}",
            "{{numero}}",
            "entregar"
          ]
        },
        "description": "AQUI ACTUA EL CONTROL DE RESPONSABLE DE BODEGA (parametro CONREBEQ).\n\nSi el usuario del token no es responsable de la bodega, el ERP responde 'Usuario no autorizado Para realizar el Tramite'. En F671 pueden: dflorez, fmartinez, OCARABALI, lcanas, JJROJAS y czuluaga.\n\nEfectos: estado 'en' y se crean las dos filas de firma vacias.\n\nSi el articulo fuera devolutivo, el paquete asignaria aqui las placas mas antiguas del almacen (FIFO). Este es de consumo, asi que no lleva placas.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lineas\": [\n    {\n      \"articulo\": \"{{articulo}}\",\n      \"bodega\": \"{{bodega}}\",\n      \"secuencia\": 1,\n      \"cantidad\": 100\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"code = 0 (sin rechazo de negocio)\", () => {",
              "    pm.expect(pm.response.json().code).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
