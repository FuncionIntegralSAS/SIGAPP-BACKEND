    {
      "name": "11. Registrar la salida recibiendo 90 de 100",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/requisiciones/{{empresa}}/{{tipoDocumento}}/{{numero}}/registrar",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "requisiciones",
            "{{empresa}}",
            "{{tipoDocumento}}",
            "{{numero}}",
            "registrar"
          ]
        },
        "description": "PUNTO DE NO RETORNO: genera el documento en el ERP y no se deshace desde la aplicacion.\n\nEl cuerpo es OPCIONAL y solo hace falta para recibir menos de lo entregado; con {} se recibe todo.\n\nConsecuencia de la recepcion parcial: las 10 unidades entregadas y no recibidas no vuelven al inventario ni quedan anuladas.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lineas\": [\n    {\n      \"articulo\": \"{{articulo}}\",\n      \"bodega\": \"{{bodega}}\",\n      \"secuencia\": 1,\n      \"cantidad\": 90\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Respuesta 200\", () => pm.response.to.have.status(200));",
              "const r = pm.response.json();",
              "pm.test(\"code = 0\", () => pm.expect(r.code).to.eql(0));",
              "if (r.object) { console.log(\"Tipo de salida:\", r.object.tipoSalida, \"| ERP:\", r.object.mensaje); }"
            ]
          }
        }
      ]
    },
